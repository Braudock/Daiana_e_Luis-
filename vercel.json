{
  "version": 2,
  "functions": {
    "api/index.ts": {
      "includeFiles": "contexto_luis_paula.md"
    },
    "api/**/*.ts": {
      "excludeFiles": "{public/media/**,dist/**,node_modules/ffmpeg-static/**,node_modules/sharp/**,node_modules/typescript/**,node_modules/vite/**}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
